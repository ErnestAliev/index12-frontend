{
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/mobile", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/team-sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }
  ],
  "functions": {
    "api/team-entry.js": { "includeFiles": "dist/index.html" }
  },
  "rewrites": [
    { "source": "/team-manifest/:token", "destination": "https://api.index12.com/api/team-chat/manifest/:token" },
    { "source": "/team/:token", "destination": "/api/team-entry?token=:token" },
    { "source": "/team/:token/", "destination": "/api/team-entry?token=:token" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
